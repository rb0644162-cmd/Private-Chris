    elseif distance >= 1e+21 then 
        return (v5 and "-" or "") .. string.format("%.2fSx", distance / 1e+21) 
    elseif distance >= 1000000000000000000 then 
        return (v5 and "-" or "") .. string.format("%.2fQi", distance / 1000000000000000000) 
    elseif distance >= 1000000000000000 then 
        return (v5 and "-" or "") .. string.format("%.2fQa", distance / 1000000000000000) 
    elseif distance >= 1000000000000 then 
        return (v5 and "-" or "") .. string.format("%.2fT", distance / 1000000000000) 
    elseif distance >= 1000000000 then 
        return (v5 and "-" or "") .. string.format("%.2fB", distance / 1000000000) 
    elseif distance >= 1000000 then 
        return (v5 and "-" or "") .. string.format("%.2fM", distance / 1000000) 
    end 
    if distance >= 1000 then 
        return (v5 and "-" or "") .. string.format("%.2fK", distance / 1000) 
    end 
    return (v5 and "-" or "") .. string.format("%.2f", distance) 
end 

